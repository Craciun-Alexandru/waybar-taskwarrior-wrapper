[general]
status_path = "~/.local/share/vdirsyncer/status/"

# wtodo lists <-> Radicale (over Tailscale)
[pair wtodo]
a = "wtodo_local"
b = "wtodo_radicale"
collections = ["from a", "from b"]
metadata = ["displayname"]
conflict_resolution = "a wins"

[storage wtodo_local]
type = "filesystem"
path = "~/.local/share/wtodo/"
fileext = ".ics"

[storage wtodo_radicale]
type = "caldav"
item_types = ["VTODO"]
url = "http://<SERVER>:5232/"
username = "ac"
password.fetch = ["command", "cat", "~/.config/vdirsyncer/radicale-password"]
