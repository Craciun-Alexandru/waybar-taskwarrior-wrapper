[server]
# Localhost only; `tailscale serve` exposes it over HTTPS to the tailnet.
hosts = 127.0.0.1:5232

[auth]
type = htpasswd
htpasswd_filename = /home/ac/.config/radicale/users
htpasswd_encryption = bcrypt

[rights]
type = owner_only

[storage]
filesystem_folder = /home/ac/.local/share/radicale/collections
