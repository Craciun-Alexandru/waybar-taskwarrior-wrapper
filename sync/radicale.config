[server]
# Tailscale address only: unreachable from the TUM network and the internet.
hosts = <SERVER-TAILSCALE-IP>:5232

[auth]
type = htpasswd
htpasswd_filename = /home/ac/.config/radicale/users
htpasswd_encryption = bcrypt

[rights]
type = owner_only

[storage]
filesystem_folder = /home/ac/.local/share/radicale/collections
